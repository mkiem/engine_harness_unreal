{
  "name": "dsh-worker-blender",
  "domain": "blender",
  "description": "Models, UV-unwraps, rigs and exports meshes in Blender, with Unreal collision and LODs, from a re-runnable bpy recipe.",
  "prompt": "prompts/worker-blender.md",
  "tools": ["bash", "file_edit", "file_search"],
  "pool": "blender",
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"],
      "env": { "BLENDER_HOST": "${BLENDER_HOST}", "BLENDER_PORT": "${BLENDER_PORT}" }
    }
  },
  "env": {
    "BLENDER_BIN": "${BLENDER_BIN}",
    "ART_STAGING_DIR": "${ART_STAGING_DIR}",
    "HARNESS_DCC_DIR": "${HARNESS_DCC_DIR}"
  },
  "requires": ["BLENDER_BIN", "BLENDER_HOST", "BLENDER_PORT", "ART_STAGING_DIR", "HARNESS_DCC_DIR"],
  "blockedCommands": ["p4 submit", "p4 revert", "git push", "git lfs unlock"]
}

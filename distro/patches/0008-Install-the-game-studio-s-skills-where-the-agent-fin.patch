+  it("installs ours, updates them, removes dropped ones, and leaves the user's skills alone", async () => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'eh-skills-'));
+    const payload = path.join(root, 'payload');
+    const target = path.join(root, 'config', 'skills');
+    skill(payload, 'game-studio', 'v1');
+    skill(payload, 'old-skill');
+    skill(target, 'my-own');
+    expect(await installHarnessSkills(payload, target)).toEqual(['game-studio', 'old-skill']);
+    fs.rmSync(path.join(payload, 'old-skill'), { recursive: true });
+    skill(payload, 'game-studio', 'v2');
+    expect(await installHarnessSkills(payload, target)).toEqual(['game-studio']);
+    expect(fs.readFileSync(path.join(target, 'game-studio', 'SKILL.md'), 'utf8')).toBe('v2');
+    expect(fs.existsSync(path.join(target, 'old-skill'))).toBe(false);
+    expect(fs.existsSync(path.join(target, 'my-own', 'SKILL.md'))).toBe(true);
+  });

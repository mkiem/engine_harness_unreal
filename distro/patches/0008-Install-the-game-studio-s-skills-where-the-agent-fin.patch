-export function withRecipeDir(current: string | undefined, recipes: string, separator: string): string {
+export function withRecipeDir(
+  current: string | undefined,
+  recipes: string,
+  separator: string
+): string {
   const entries = (current ?? '').split(separator).filter(Boolean);
-  return entries.includes(recipes) ? entries.join(separator) : [...entries, recipes].join(separator);
+  return entries.includes(recipes)
+    ? entries.join(separator)
+    : [...entries, recipes].join(separator);
+}
+
+const SKILLS_MANIFEST = '.engine-harness-skills.json';
+
+/**
+ * Installs the game studio's agent skills (resources/harness/skills/<name>/SKILL.md) into the skills folder goose reads
+ * (<GOOSE_PATH_ROOT>/config/skills), replacing older copies of ours and removing ones a newer version dropped. Skills the
+ * user added there are left alone. Answers the names installed.
+ */
+export async function installHarnessSkills(
+  payloadSkills: string,
+  target: string
+): Promise<string[]> {
+  if (!fs.existsSync(payloadSkills)) return [];
+  const names = (await fs.promises.readdir(payloadSkills, { withFileTypes: true }))
+    .filter(
+      (entry) =>
+        entry.isDirectory() && fs.existsSync(path.join(payloadSkills, entry.name, 'SKILL.md'))
+    )
+    .map((entry) => entry.name)
+    .sort();
+  await fs.promises.mkdir(target, { recursive: true });
+  const manifest = path.join(target, SKILLS_MANIFEST);
+  let previous: string[] = [];
+  try {
+    previous = JSON.parse(await fs.promises.readFile(manifest, 'utf8')).skills ?? [];
+  } catch {
+    // First install.
+  }
+  for (const name of previous.filter(
+    (old) => !names.includes(old) && !old.includes('..') && !path.isAbsolute(old)
+  )) {
+    await fs.promises.rm(path.join(target, name), { recursive: true, force: true });
+  }
+  for (const name of names) {
+    await fs.promises.rm(path.join(target, name), { recursive: true, force: true });
+    await fs.promises.cp(path.join(payloadSkills, name), path.join(target, name), {
+      recursive: true,
+    });
+  }
+  await fs.promises.writeFile(manifest, JSON.stringify({ skills: names }, null, 2));
+  return names;
+}
+
+/** The skills folder goose reads for this app: <GOOSE_PATH_ROOT>/config/skills, else ~/.agents/skills. */
+export function harnessSkillsDir(env: typeof process.env = process.env): string {
+  const root = env.GOOSE_PATH_ROOT;
+  return root && path.isAbsolute(root)
+    ? path.join(root, 'config', 'skills')
+    : path.join(os.homedir(), '.agents', 'skills');
 }
 
